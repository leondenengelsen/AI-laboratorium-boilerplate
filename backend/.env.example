# ============================================================
# AI Lab Boilerplate — Backend Environment Variables
# ============================================================
# Copy this file to the project root as .env:
#   cp backend/.env.example .env
# ============================================================

# Required: 32-byte hex encryption key for API key storage
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-string-here

# Server port (default: 3000)
PORT=3000

# Allowed frontend origin for CORS (default: http://localhost:4200)
FRONTEND_ORIGIN=http://localhost:4200
